# ================================
# DATABASE (PostgreSQL container)
# ================================
DB_USERNAME=cbs_user
DB_PASSWORD=change_this_strong_password
DB_NAME=cbs_db

# ================================
# BACKEND
# ================================
JWT_SECRET=change_this_to_a_long_random_secret

# URL publik backend (dipakai untuk generate URL file upload)
APP_URL=http://localhost:8080

# URL frontend yang diizinkan mengakses backend (CORS)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ================================
# FRONTEND
# ================================
# URL backend yang diakses oleh browser (harus dapat diakses dari luar container)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ================================
# PORT (opsional, default sudah diset)
# ================================
BACKEND_PORT=8080
FRONTEND_PORT=3000
